{
  "expo": {
    "name": "Twofold",
    "slug": "twofold",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sonotechnologies.twofold"
    },
    "android": {
      "package": "com.sonotechnologies.twofold",
      "adaptiveIcon": {
        "backgroundColor": "#5A1838",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Twofold uses the microphone to record voice notes for your partner."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#5A1838",
          "dark": {
            "backgroundColor": "#2A0B1C"
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Twofold lets you send photos to your partner.",
          "cameraPermission": "Twofold lets you take photos to send to your partner."
        }
      ],
      "expo-web-browser",
      "expo-asset"
    ],
    "scheme": "twofold",
    "backgroundColor": "#FBF3EC",
    "experiments": {
      "typedRoutes": true
    }
  }
}
